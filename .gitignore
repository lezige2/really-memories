!kvmem/m2_visibility/m3/run_m3_redB.json
!kvmem/m2_visibility/m3/run_m3_lifecycle_3rounds.json
!kvmem/m2_visibility/m4/run_m4_write.json
!kvmem/m2_visibility/m4/run_m4_verify.json
!kvmem/m2_visibility/m4/evidence_think_tag.json
!kvmem/m2_visibility/m4/run_stage3.json
!kvmem/m2_visibility/m4/PREREG-STAGE3-11ROWS.json
!kvmem/m2_visibility/m4/run_m5_grounded.json
!kvmem/m2_visibility/m4/run_m5_fix_compare.json
!kvmem/m2_visibility/m4/run_m4_verify_a2.json
!kvmem/m2_visibility/m4/run_m4_verify_a3.json
!kvmem/m2_visibility/m4/run_m4_verify_a4.json
!kvmem/m2_visibility/m4/run_m4_outfilter_selftest.json
!kvmem/m2_visibility/m4/run_m4_ablate_plate_a1.json
!kvmem/m2_visibility/m4/run_m4_ablate_plate_a2.json
!kvmem/m2_visibility/m4/run_m4_ablate_plate_a3.json
!kvmem/m2_visibility/m4/run_m5_grounded.json
