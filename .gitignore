kvmem/lease_events*.jsonl
kvmem/lease_refusals*.jsonl
*.jsonl.b
kvmem/m2_visibility/**/events*.jsonl

# 本轮新增：分 run 日志目录（每 run 一个文件，路径与 sha256 记在 run json 里）
kvmem/lease_logs/
kvmem/m2_visibility/**/logs/

# 证据面例外：_before/ 是唯一副本存储（其中 3 个 m5_bridge 态从未进过 git）。
# 唯一副本没有失效信号 -- 丢了不会报错，只会不存在。故强制入版本库。
!**/m4/_before/
!**/m4/_before/**

# 编译缓存不是证据
__pycache__/
*.pyc

# ===== 证据产物放行（锚必须可复算）=====
# 上面的 *.json 是全局排除，导致 run 产物进不了仓库；而所有验收结论都锚在它们的 sha256 上。
# 只放行被验收文档点名为锚的这几个文件，不做目录级放行。
!kvmem/m2_visibility/m3/run_m3_lifecycle_50_v4.json
!kvmem/m2_visibility/m3/run_m3_criterion_declarations.json
!kvmem/m2_visibility/m3/run_m3_unit_falsifiers.json
