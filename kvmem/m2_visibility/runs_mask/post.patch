+// ---------------------------------------------------------------------------
+// seq_repos_local: move a few cells and rotate *only their* K.
+//
+// Why a delta rotation is exact: in ggml_rope_cache_init() the angle for dimension
+// pair j is  theta_j(pos) = pos * w_j  with  w_j = theta_scale^j / ff_j, and the
+// YaRN ramp depends only on the dimension index i0, never on pos. So the angle is
+// linear in pos and  R(pos2) = R(pos1) * R(pos2 - pos1).  mscale is a magnitude
+// factor already baked in at encode time, so a pure rotation must not re-apply it.
+//
+// Why per-cell and not per-tensor: layer.k is a 3D tensor
+//   [n_embd_k_gqa, kv_size, n_stream]
+// so one cell is a contiguous run of nb[1] bytes at s*nb[2] + i*nb[1]. We read
+// exactly that run, rotate it and write it back -- physically no other cell can be
+// touched, unlike build_graph_shift() which rewrites the whole K tensor.
+// ---------------------------------------------------------------------------
+static inline float llama_kv_yarn_ramp(float low, float high, int i0) {
+    const float y = (i0 / 2 - low) / std::max(0.001f, high - low);
+    return 1.0f - std::min(1.0f, std::max(0.0f, y));
+}
+
+// Orthonormal Walsh-Hadamard transform, in place, O(n log n).
+//
+// This cache stores K in the Walsh-Hadamard basis whenever n_rot_k != 0: the write
+// path applies H to K (and to Q, so the scores are unchanged since H is orthogonal).
+// RoPE does NOT commute with H, so a shift must be done as H -> rope -> H, exactly
+// as build_graph_shift() does it. H here is the same matrix ggml_gen_hadamard()
+// builds (orthonormal Sylvester), so H*H = I.
+static void llama_kv_fwht(float * x, int64_t n) {
+    GGML_ASSERT(n > 0 && (n & (n - 1)) == 0 && "hadamard size must be a power of 2");
+
+    for (int64_t h = 1; h < n; h *= 2) {
+        for (int64_t i = 0; i < n; i += 2*h) {
+            for (int64_t j = i; j < i + h; ++j) {
+                const float a = x[j];
+                const float b = x[j + h];
+                x[j]     = a + b;
+                x[j + h] = a - b;
+            }
+        }
+    }
+
+    const float s = 1.0f / sqrtf((float) n);
+    for (int64_t i = 0; i < n; ++i) {
+        x[i] *= s;
+    }
+}
+
+// rotate one head's K values by delta * w_j; only the first n_rot dims participate
+static void llama_kv_rope_delta(
+        float * x, int64_t n_rot, bool neox,
+        float delta, float theta_scale, float freq_scale,
+        float ext_factor, const float corr_dims[2]) {
+    const int64_t half = n_rot / 2;
+
+    float theta = delta;               // theta_base, i.e. the position delta itself
+
+    for (int64_t i0 = 0; i0 < n_rot; i0 += 2) {
+        const float theta_extrap = theta;
+        const float theta_interp = freq_scale * theta_extrap;
+
+        float th = theta_interp;
+        if (ext_factor != 0.0f) {
+            const float ramp_mix = llama_kv_yarn_ramp(corr_dims[0], corr_dims[1], (int) i0) * ext_factor;
+            th = theta_interp * (1.0f - ramp_mix) + theta_extrap * ramp_mix;
+        }
+
+        const float c = cosf(th);
+        const float s = sinf(th);
+
+        // NEOX-style pairs (j, j + n_rot/2); NORMAL pairs (2j, 2j + 1)
+        const int64_t a = neox ? (i0 / 2)       : i0;
+        const int64_t b = neox ? (i0 / 2 + half) : (i0 + 1);
+
+        const float xa = x[a];
+        const float xb = x[b];
+
+        x[a] = xa * c - xb * s;
+        x[b] = xa * s + xb * c;
+
+        theta *= theta_scale;
+    }
+}
+
+uint32_t llama_kv_cache::seq_repos_local(
+        llama_seq_id seq_id,
+           llama_pos p0,
+           llama_pos p1,
+           llama_pos delta) {
+    // the shared-cell layout keeps two caches in sync - not supported here
+    if (other || delta == 0) {
+        return 0;
+    }
+
+    GGML_ASSERT(cparams_ptr != nullptr && "seq_repos_local() called before llama_context injected cparams");
+    const llama_cparams & cparams = *cparams_ptr;
+
+    GGML_ASSERT(seq_id >= 0 && (size_t) seq_id < seq_to_stream.size());
+    GGML_ASSERT(hparams.n_pos_per_embd() == 1 && "seq_repos_local() needs one position per token");
+
+    const uint32_t s = seq_to_stream[seq_id];
+
+    auto & cells = v_cells[s];
+
+    if (p0 < 0) { p0 = 0; }
+    if (p1 < 0) { p1 = std::numeric_limits<llama_pos>::max(); }
+
+    // 1) exactly the cells that move. nothing else is even looked at.
+    std::vector<uint32_t> idxs;
+
+    for (uint32_t i = 0; i < cells.size(); ++i) {
+        if (!cells.pos_in (i, p0, p1)) continue;
+        if (!cells.seq_has(i, seq_id)) continue;
+
+        idxs.push_back(i);
+    }
+
+    if (idxs.empty()) {
+        return 0;
+    }
+
+    // A freshly loaded block usually occupies consecutive cells. Transferring one
+    // cell at a time means one submit+fence per cell per layer (measured: ~500 ms
+    // for a 145-token block), so batch maximal runs of consecutive cells instead.
+    std::vector<std::pair<uint32_t, uint32_t>> runs; // [begin, end) into idxs
+    for (size_t k = 0; k < idxs.size(); ) {
+        size_t e = k + 1;
+        while (e < idxs.size() && idxs[e] == idxs[e - 1] + 1) {
+            ++e;
+        }
+        runs.emplace_back((uint32_t) k, (uint32_t) e);
+        k = e;
+    }
+
+    // 2) preflight. Every "this model is not supported" decision has to be made
+    //    BEFORE the first byte is written: the loop below writes each layer back as
+    //    it goes, so a `return 0` in the middle would leave the earlier layers
+    //    already rotated while cells.pos_move() never runs -- K encoding the new
+    //    positions with the bookkeeping still at the old ones. The caller would then
+    //    fall back to seq_add() and rotate a second time. Silent corruption, on
+    //    exactly the models we do not test.
+    //
+    //    SEAM: LLAMA_KV_REPOS_FAULT_LAYER is a permanent, refusal-only test seam.
+    //    Contract:  * it can ONLY make this preflight refuse; it cannot skip work,
+    //                 move positions, or hide an error;
+    //               * it is read once, here, before any loop -- never in the write
+    //                 path, never allocating, and when disabled it costs one getenv;
+    //               * it always logs when it fires, so an injected 0 is never
+    //                 mistaken for a real capability limit;
+    //               * unset => identical behaviour (regression in p0_2_check.py).
+    //    Why it exists: this model can never take the rope_freqs / n_rot != head_dim
+    //    branches, so without a seam the refusal path itself is untestable, and an
+    //    untested safety path rots. Revisit when a sealed production binary is
+    //    required (QQ / multi-tenant distribution): move it to a test build then.
+    const int fault_layer = ([]() {
+        const char * f = getenv("LLAMA_KV_REPOS_FAULT_LAYER");
+        return f ? atoi(f) : -1;
+    })();
+
+    for (const auto & layer : layers) {
+        const uint32_t il = layer.il;
+
+        if (!layer.k || !hparams.has_rope(il)) {
+            continue;
+        }
+
+        if ((int) il == fault_layer) {
+            LLAMA_LOG_WARN("%s: injected fault at layer %u - refusing local repos "
+                           "(LLAMA_KV_REPOS_FAULT_LAYER; this 0 is NOT a capability limit)\n",
+                           __func__, il);
+            return 0;
+        }
+
+        const int64_t n_rot         = hparams.n_rot(il);
+        const int64_t n_embd_head_k = hparams.n_embd_head_k(il);
+        const int64_t n_embd_k_gqa  = hparams.n_embd_k_gqa(il);
+
+        // custom per-dimension freq factors live in a backend tensor; refuse those
+        // (the caller can fall back to seq_add()) instead of silently diverging
+        if (model.get_rope_factors(cparams, il) != nullptr) {
+            LLAMA_LOG_WARN("%s: layer %u uses rope freq factors - refusing local repos\n", __func__, il);
+            return 0;
+        }
+
+        // K may live in the Walsh-Hadamard basis - see llama_kv_fwht()
+        if (n_rot_k != 0 && n_rot != n_embd_head_k) {
+            LLAMA_LOG_WARN("%s: layer %u has n_rot %d != n_embd_head_k %d with key rotation - "
+                           "refusing local repos\n", __func__, il, (int) n_rot, (int) n_embd_head_k);
+            return 0;
+        }
+
+        const auto * traits = ggml_get_type_traits(layer.k->type);
+        if (!traits || !traits->to_float || n_embd_k_gqa % traits->blck_size != 0) {
+            LLAMA_LOG_WARN("%s: layer %u K type is not convertible in whole blocks - "
+                           "refusing local repos\n", __func__, il);
+            return 0;
+        }
+    }
+
+    // 3) rotate their K in place, per cell. From here on nothing may return early.
+    for (const auto & layer : layers) {
+        const uint32_t il = layer.il;
+
+        if (!layer.k || !hparams.has_rope(il)) {
+            continue;
+        }
+
+        const int64_t n_rot         = hparams.n_rot(il);
+        const int64_t n_head_kv     = hparams.n_head_kv(il);
+        const int64_t n_embd_head_k = hparams.n_embd_head_k(il);
+        const int64_t n_embd_k_gqa  = hparams.n_embd_k_gqa(il);
+
+        // some archs store the non-rotated part at the start of each head
+        const int64_t n_nope = hparams.n_lora_kv > 0 ? n_embd_head_k - n_rot : 0;
+
+        const float freq_base_l  = model.get_rope_freq_base (cparams, il);
+        const float freq_scale_l = model.get_rope_freq_scale(cparams, il);
+
+        const float theta_scale = powf(freq_base_l, -2.0f / (float) n_rot);
+
+        float corr_dims[2] = { 0.0f, 0.0f };
+        if (cparams.yarn_ext_factor != 0.0f) {
+            ggml_rope_yarn_corr_dims(n_rot, cparams.n_ctx_orig_yarn, freq_base_l,
+                                     cparams.yarn_beta_fast, cparams.yarn_beta_slow, corr_dims);
+        }
+
+        const bool neox = hparams.rope_type != LLAMA_ROPE_TYPE_NORM;
+
+        // already validated in the preflight pass above
+        const bool use_hadamard = n_rot_k != 0;
+
+        const auto * traits = ggml_get_type_traits(layer.k->type);
+        GGML_ASSERT(traits != nullptr && traits->to_float != nullptr);
+
+        const size_t nb_cell = layer.k->nb[1];
+        GGML_ASSERT(nb_cell == ggml_row_size(layer.k->type, n_embd_k_gqa));
+        GGML_ASSERT(n_embd_k_gqa % traits->blck_size == 0);
+
+        // bound the scratch buffers for very long runs (256 cells * 512 f32 = 512 KiB)
+        constexpr uint32_t MAX_CHUNK = 256;
+
+        std::vector<uint8_t> raw;
+        std::vector<float>   f32;
+
+        for (const auto & run : runs) {
+            for (uint32_t k = run.first; k < run.second; k += MAX_CHUNK) {
+                const uint32_t lo = idxs[k];
+                const uint32_t hi = idxs[std::min(k + MAX_CHUNK, run.second) - 1];
+                const uint32_t ncell = hi - lo + 1;   // all of them are in idxs (run is maximal)
+
+                const size_t off  = (size_t) s * layer.k->nb[2] + (size_t) lo * nb_cell;
+                const size_t nbyt = (size_t) ncell * nb_cell;
+
+                raw.resize(nbyt);
+                f32.resize((size_t) ncell * n_embd_k_gqa);
+
+                ggml_backend_tensor_get(layer.k, raw.data(), off, nbyt);
+
+                traits->to_float(raw.data(), f32.data(), (int64_t) ncell * n_embd_k_gqa);
+
+                for (uint32_t c = 0; c < ncell; ++c) {
+                    float * cell_k = f32.data() + (size_t) c * n_embd_k_gqa;
+
+                    for (int64_t h = 0; h < n_head_kv; ++h) {
+                        float * head_k = cell_k + h * n_embd_head_k + n_nope;
+
+                        if (use_hadamard) {
+                            llama_kv_fwht(head_k, n_rot);   // into the rope basis
+                        }
+
+                        llama_kv_rope_delta(head_k, n_rot, neox, (float) delta,
+                                            theta_scale, freq_scale_l,
+                                            cparams.yarn_ext_factor, corr_dims);
+
+                        if (use_hadamard) {
+                            llama_kv_fwht(head_k, n_rot);   // back to the stored basis
+                        }
+                    }
+                }
+
+                ggml_quantize_chunk(layer.k->type, f32.data(), raw.data(),
+                                    0, (int64_t) ncell, n_embd_k_gqa, nullptr);
+
+                ggml_backend_tensor_set(layer.k, raw.data(), off, nbyt);
+            }
+        }
+    }
+
+    // 3) move the positions. pos_move() (not pos_add()) because the rotation is
+    //    already applied - pos_add() would leave a pending K-shift and rotate twice.
+    for (uint32_t i : idxs) {
+        cells.pos_move(i, delta);
+    }
+
+    return (uint32_t) idxs.size();
+}
