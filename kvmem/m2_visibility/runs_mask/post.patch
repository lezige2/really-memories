+                        const char * mq   = getenv("LLAMA_KV_MASK_Q");
+                        if (mlay == nullptr) { mlay = "na"; }
+                        if (mq   == nullptr) { mq   = "na"; }
+                        int64_t ok_n = 0, drop_n = 0, ok_first = -1, ok_last = -1;
+                        for (int64_t k = 0; k < n_kv; ++k) {
+                            if (data[idst + k] == mask_drop) { ++drop_n; }
+                            else { ++ok_n; if (ok_first < 0) { ok_first = k; } ok_last = k; }
+                        }
+                        fprintf(stderr, "[MASKDBG-SUM] layout=%s q=%s seq=%d p1=%d n_kv=%lld n_ub=%u type=%s seq_pos_min=%d idxs=%zu row_allowed=%lld row_masked=%lld ok_first=%lld ok_last=%lld\n",
+                                mlay, mq,
+                                (int) seq_id, (int) p1, (long long) n_kv, (unsigned) ubatch->n_tokens,
+                                sizeof(T) == 2 ? "f16" : "f32", (int) seq_pos_min[seq_id],
+                                idxs.size(), (long long) ok_n, (long long) drop_n,
+                                (long long) ok_first, (long long) ok_last);
+                        const char * mwin = getenv("LLAMA_KV_MASK_WINDOWS");
+                        if (mwin != nullptr) {
+                            char mbuf[512];
+                            snprintf(mbuf, sizeof(mbuf), "%s", mwin);
+                            for (char * tok = strtok(mbuf, ","); tok != nullptr; tok = strtok(nullptr, ",")) {
+                                char * c1 = strchr(tok, ':');
+                                if (c1 == nullptr) { continue; }
+                                *c1 = '\0';
+                                char * c2 = strchr(c1 + 1, ':');
+                                if (c2 == nullptr) { continue; }
+                                *c2 = '\0';
+                                const int64_t lo = atoll(c1 + 1);
