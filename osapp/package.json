{
  "name": "llama-mem-os",
  "version": "0.1.0",
  "private": true,
  "description": "llama-mem desktop shell (tray + local service + memory UI)",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "electron .",
    "dist": "vite build && electron-builder"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "electron": "^45.3.2",
    "electron-builder": "^26.0.12",
    "svelte": "^5.0.0",
    "vite": "^7.0.0"
  },
  "build": {
    "appId": "dev.llamamem.os",
    "productName": "llama-mem",
    "directories": {"output": "release-builder"},
    "files": ["dist/**/*", "electron/**/*", "package.json"],
    "win": {"target": ["nsis"], "icon": "electron/icon.ico"},
    "nsis": {"include": "installer/nsis-context.nsh"}
  }
}