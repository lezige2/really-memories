{"id": "R2-C01", "group": "chain", "kind": "换牌（同主体）", "query": "我车牌现在挂的是哪个号？", "subject": "我的车/.车牌", "old_value": "粤A·12345", "new_value": "粤B·67890", "setup": ["我的车是黑色轿车，车牌是粤A·12345", "车牌换到粤B·67890了"], "expected_action": "supersede", "target_block": {"kind": "chain", "ref": "R2-C01"}, "note": "撞车对之一：cue『换到』指向同一主体，旧牌应被压掉"}
{"id": "R2-C02", "group": "chain", "kind": "新买一辆（新主体）", "query": "我这辆车现在是什么车牌？", "subject": "我的车#1/.车牌  vs  我的车#2/.车牌", "old_value": "粤A·12345（车#1）", "new_value": "粤B·67890（车#2）", "setup": ["我的车是黑色轿车，车牌是粤A·12345", "上个月又提了一辆车，车牌是粤B·67890"], "expected_action": "ask", "target_block": {"kind": "chain", "ref": "R2-C02"}, "note": "撞车对：同为车牌但主体新增，不得覆盖车#1；主体不明应 ask"}
{"id": "R2-C03", "group": "chain", "kind": "两号并行（手机/座机）", "query": "我办公室座机是多少？", "subject": "我/.手机  vs  我/.座机", "old_value": "137-0000-0001（手机）", "new_value": "010-8888-0002（座机）", "setup": ["我的手机号是137-0000-0001", "我办公室座机是010-8888-0002"], "expected_action": "ignore", "target_block": {"kind": "synthetic"}, "note": "座机是新槽位，写入不应覆盖手机；本条只新增"}
{"id": "R2-C04", "group": "chain", "kind": "两卡并行（工资卡/社保卡）", "query": "我的社保卡号是多少？", "subject": "我/.工资卡  vs  我/.社保卡", "old_value": "6222 0000 3333 4444（社保卡）", "new_value": "6222 0000 5555 6666（社保卡换卡）", "setup": ["我的工资卡是6217 0000 1111 2222", "我的社保卡是6222 0000 3333 4444", "社保卡换成6222 0000 5555 6666了"], "expected_action": "supersede", "target_block": {"kind": "synthetic"}, "note": "只替换社保卡，工资卡不得被覆盖"}
{"id": "R2-C05", "group": "chain", "kind": "两工位并行（上海/北京）", "query": "我在北京的工位在哪？", "subject": "我/.工位#上海  vs  我/.工位#北京", "old_value": "5楼C区（北京）", "new_value": "6楼D区（北京）", "setup": ["我在上海的工位是2楼A区", "我在北京的工位是5楼C区", "北京工位换到6楼D区了"], "expected_action": "supersede", "target_block": {"kind": "synthetic"}, "note": "只改北京工位；上海工位为并列主体"}
{"id": "R2-C06", "group": "chain", "kind": "主体缺失句", "query": "我车牌改成什么了？", "subject": "(缺主体)/.车牌", "old_value": "粤A·12345", "new_value": "京Q·77777", "setup": ["我的车是黑色轿车，车牌是粤A·12345", "车牌改成京Q·77777了"], "expected_action": "ambiguous", "target_block": {"kind": "chain", "ref": "R2-C06"}, "note": "无『我的』限定，可能是他人车辆 → 不猜"}
{"id": "R2-C07", "group": "chain", "kind": "旧值回写陷阱", "query": "我现在用的手机号是哪个？", "subject": "我/.手机", "old_value": "135-0000-1111（已弃用）", "new_value": "159-0000-9999（当前）", "setup": ["我的手机号改成159-0000-9999了", "原来135-0000-1111那个号我还留着当备用"], "expected_action": "ignore", "target_block": {"kind": "synthetic"}, "note": "后句只是保留旧号（持有），不是改回；当前值仍为159"}
{"id": "R2-C08", "group": "chain", "kind": "同名两人（跨主体）", "query": "王伟的车牌是多少？", "subject": "王伟/.车牌  vs  王玮/.车牌", "old_value": "沪A·10101（王伟）", "new_value": "沪B·20202（王玮）", "setup": ["王伟的车牌是沪A·10101", "王玮的车牌换成沪B·20202了"], "expected_action": "ignore", "target_block": {"kind": "synthetic"}, "note": "王伟≠王玮，跨主体不得串写"}
{"id": "R2-C09", "group": "chain", "kind": "两猫并行·只改一只", "query": "家里那只大猫现在叫什么名字？", "subject": "我/.猫#大猫", "old_value": "年糕", "new_value": "米糕", "setup": ["我养了两只猫，大猫叫年糕，小猫叫汤圆", "大猫改名成米糕了"], "expected_action": "supersede", "target_block": {"kind": "synthetic"}, "note": "只替换大猫；小猫咪咪/汤圆为并列主体"}
{"id": "R2-C10", "group": "chain", "kind": "两会议槽（周一/周四）", "query": "我周一的项目会几点？", "subject": "我/.会议#周一", "old_value": "九点", "new_value": "十点", "setup": ["我周一的项目会是九点，周四的评审会是下午三点", "周一的项目会改到十点了"], "expected_action": "supersede", "target_block": {"kind": "synthetic"}, "note": "只改周一槽；周四不变"}
{"id": "R2-C11", "group": "chain", "kind": "两出差槽（下周北京/下月上海）", "query": "我下周去北京是哪天？", "subject": "我/.出差#下周北京", "old_value": "下周三", "new_value": "下周五", "setup": ["我下周三去北京出差，下个月还要去上海", "去北京那趟改到下周五了"], "expected_action": "supersede", "target_block": {"kind": "synthetic"}, "note": "日期槽变化只影响北京那趟；上海那趟不动"}
{"id": "R2-C12", "group": "chain", "kind": "银行卡换行（同卡）", "query": "我的银行卡是哪个行的？", "subject": "我/.银行卡", "old_value": "招商银行", "new_value": "工商银行", "setup": ["我的银行卡是招商银行的", "同一张卡换到工商银行了"], "expected_action": "supersede", "target_block": {"kind": "synthetic"}, "note": "同卡换行=同槽更新，旧行名应被压掉"}
{"id": "R2-N01", "group": "negation", "kind": "否定·不是", "query": "我的车牌还是粤A·12345吗？", "subject": "我的车/.车牌", "old_value": "粤A·12345", "new_value": null, "setup": ["我的车牌不是粤A·12345了"], "expected_action": "ambiguous", "target_block": {"kind": "chain", "ref": "R2-N01"}, "note": "只否定未给新值 → 不猜，保留原文"}
{"id": "R2-N02", "group": "negation", "kind": "离开·已离职", "query": "我现在在哪家公司工作？", "subject": "我/.公司", "old_value": "顺丰", "new_value": null, "setup": ["我在顺丰上班", "我从顺丰离职了"], "expected_action": "supersede", "target_block": {"kind": "synthetic"}, "note": "离职覆盖旧雇主，不得继续答顺丰"}
{"id": "R2-N03", "group": "negation", "kind": "离开·已搬走", "query": "组会现在在哪个房间？", "subject": "我/.会议地点", "old_value": "B座302", "new_value": null, "setup": ["我的组会在B座302", "我已经搬出B座302了"], "expected_action": "supersede", "target_block": {"kind": "baseline", "id": 2}, "note": "地点作废，不得再答B座302"}
{"id": "R2-N04", "group": "negation", "kind": "离开·已退卡", "query": "我的健身卡还有效吗？", "subject": "我/.健身卡", "old_value": "有效（年卡）", "new_value": null, "setup": ["我办了健身年卡", "健身卡我已经退了"], "expected_action": "supersede", "target_block": {"kind": "synthetic"}, "note": "状态翻转，不得继续答有效"}
{"id": "R2-N05", "group": "negation", "kind": "离开·停用号码", "query": "我的备用手机号是多少？", "subject": "我/.手机#备用", "old_value": "131-0000-2222", "new_value": null, "setup": ["我的备用号是131-0000-2222", "那个备用号我已经停用了"], "expected_action": "supersede", "target_block": {"kind": "synthetic"}, "note": "停用覆盖旧号"}
{"id": "R2-N06", "group": "negation", "kind": "否定·不是该公司", "query": "我是不是在字节跳动工作？", "subject": "我/.公司", "old_value": "字节跳动", "new_value": null, "setup": ["我不在字节跳动上班"], "expected_action": "ignore", "target_block": null, "note": "纯否定且库中无正面事实 → 不写入正面事实"}
