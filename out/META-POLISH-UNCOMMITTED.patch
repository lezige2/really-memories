+    _META_LEAK_RE = re.compile(
+        r"只改写|数字只能来自|facts|\bcount\b|注入", re.I)
+
+    def _meta_prompt(self, q, f, template):
+        return ("只改写下面这段事实说明，不要新增/删除/改动任何数字或单位；"
+                "数字只能来自：%s。问题：%s\n原文：%s" % (
+                    json.dumps(f, ensure_ascii=False), q[:80], template))
+
+    def _meta_polish_call(self, prompt):
+        pos = self.chat_start if int(self.eng.n_tokens(0)) == 0 else None
+        return self.eng.ask(0, prompt, n_predict=96, pos=pos)
+
+    def _meta_validate(self, text, f, template, need_count=False, need_space=False):
+        """严格校验：数字全来自注入集合；单位随问题类型；注入泄漏判失败。"""
+        s = str(text or "")
+        if not s.strip():
+            return "empty"
+        if self._META_LEAK_RE.search(s):
+            return "prompt_leak"
+        allowed = set()
+        for k in ("count", "kv_mb", "db_mb", "total_mb", "kv_gb", "db_gb",
+                  "total_gb", "kv_bytes", "db_bytes", "total_bytes"):
+            v = f.get(k)
+            if v is None:
+                continue
+            allowed.add(str(v))
+            if isinstance(v, float):
+                allowed.add(str(int(v)))
+                allowed.add("%.1f" % v)
+                allowed.add("%.2f" % v)
+        nums = re.findall(r"\d+(?:\.\d+)?", s.replace(",", ""))
+        for x in nums:
+            if x not in allowed:
+                return "extra_or_changed_number:%s" % x
+        if need_count:
+            if "条" not in s:
+                return "missing_unit:条"
+            if f.get("count", 0) > 0 and str(f["count"]) not in nums:
+                return "missing_count"
+        if need_space:
+            for unit in ("MB", "GB"):
+                if unit.lower() not in s.lower():
+                    return "missing_unit:%s" % unit
+        return None
+
